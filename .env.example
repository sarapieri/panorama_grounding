# cp .env.example .env and fill in the paths (.env is gitignored). Every variable is read by
# the configs and scripts; unset ones fall back to ./data/.

# Outputs: <root>/<config>/{train,hf,evals}
PANORAMA_RESULTS_ROOT=/path/to/results

# SAM 3 weights (facebook/sam3 on Hugging Face)
PANORAMA_SAM3_PATH=/path/to/sam3.pt

# --- Training data ---
# RefCOCO/+/g (ref_seg/) and GCG (glamm_data/) annotations and images, in the Sa2VA-Training layout
PANORAMA_DATA_ROOT=/path/to/Sa2VA-Training/
# gRefCOCO (grefs(unc).json, instances.json) and PhraseCut (VGPhraseCut_v0/)
PANORAMA_GREFCOCO_ROOT=/path/to/grefcoco
PANORAMA_PHRASECUT_ROOT=/path/to/phrasecut
# PanoCaps train split: annotation prefix (<prefix>_caption.json, <prefix>_mask.json) and images
PANORAMA_PANOCAPS_ROOT=/path/to/PanoCaps/annotations/train
PANORAMA_PANOCAPS_IMAGES=/path/to/PanoCaps/images/train
# COCONut-PanCap-Recaptioned captions and panoptic json, COCONut-S panoptic PNGs
PANORAMA_COCONUT_ROOT=/path/to/COCONut-PanCap-Recaptioned/
PANORAMA_COCONUT_JSON=/path/to/COCONut-PanCap-Recaptioned/coconut_s_panoptic_train2017.json
PANORAMA_COCONUT_MASKS=/path/to/COCONut/coconut_s/panoptic
# MRSeg-Referring-Expressions: folder containing accepted/
PANORAMA_MRSEG_EXTRACT=/path/to/mrseg_extract
# Image sources shared by several buckets: COCO train2017 (COCONut-PanCap, MRSeg), Visual Genome
# VG_100K/ and VG_100K_2/ (PhraseCut, MRSeg), ADE20K and PASCAL VOC2010 images (MRSeg)
PANORAMA_COCO_TRAIN2017=/path/to/COCO/train2017/
PANORAMA_VG_IMAGES=/path/to/VisualGenome
PANORAMA_ADE20K_IMAGES=/path/to/ADEChallengeData2016/images/training
PANORAMA_PASCAL_IMAGES=/path/to/VOCdevkit/VOC2010/JPEGImages

# --- Evaluation data ---
# GroundingSuite-Eval (GroundingSuite-Eval.jsonl and unlabeled2017/)
PANORAMA_GSEVAL_ROOT=/path/to/GSEval

# --- Optional ---
# PANORAMA_FT_INIT_PTH   checkpoint a finetune starts from (default: the parent run's last_checkpoint)
# PANORAMA_CACHE_DIR     where the COCONut-PanCap manifest cache is written (default: data/.cache)
# PANORAMA_ATTN_IMPL     VLM attention for training and eval: flash_attention_2 (default) or sdpa;
#                        use sdpa to run without flash-attn
# PANORAMA_CAPTURE_GT_CACHE   folder for the cached CAPTURE parse of the PanoCaps GT captions (default: beside the GT files)
